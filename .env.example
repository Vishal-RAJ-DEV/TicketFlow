# Root Docker Compose settings for local development only.
POSTGRES_PASSWORD=local-dev-postgres-password
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=local-dev-pgadmin-password
REDIS_PASSWORD=local-dev-redis-password

# Generate with: openssl rand -hex 32
# Configure the same secret in api-gateway and event-service .env files.
GATEWAY_ASSERTION_SECRET=replace-this-with-a-random-64-character-hex-secret
