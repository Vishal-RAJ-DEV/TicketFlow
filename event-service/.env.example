PORT=4003
NODE_ENV=development
LOG_LEVEL=info

# Must match GATEWAY_ASSERTION_SECRET configured in api-gateway.
# Generate with: openssl rand -hex 32
GATEWAY_ASSERTION_SECRET=replace_with_the_same_random_secret_in_both_services
GATEWAY_ASSERTION_SECRET_PREVIOUS=

USER_SERVICE_URL=http://localhost:4001
USER_SERVICE_INTERNAL_KEY=replace_with_random_secret_shared_with_user_service
USER_SERVICE_TIMEOUT_MS=3000
USER_STATUS_CACHE_TTL_MS=15000

# Production mTLS listener settings.
EVENT_SERVICE_TLS_ENABLED=false
EVENT_SERVICE_TLS_CERT_FILE=/run/secrets/event_service_cert
EVENT_SERVICE_TLS_KEY_FILE=/run/secrets/event_service_key
EVENT_SERVICE_MTLS_CA_FILE=/run/secrets/gateway_client_ca
EVENT_SERVICE_MTLS_CLIENT_CNS=ticketflow-api-gateway,ticketflow-prometheus

# Production Kafka TLS + SASL/SCRAM.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CA_FILE=
KAFKA_CERT_FILE=
KAFKA_KEY_FILE=
KAFKA_ALLOW_AUTO_TOPIC_CREATION=true

OUTBOX_MAX_ATTEMPTS=12
OCCURRENCE_LIFECYCLE_POLL_INTERVAL_MS=15000
OCCURRENCE_LIFECYCLE_BATCH_SIZE=100
EVENT_SERVICE_OPS_TOKEN=replace_with_random_ops_token_at_least_32_chars
EVENT_SERVICE_METRICS_TOKEN=replace_with_random_metrics_token_at_least_32_chars

# Create this database in the local PostgreSQL instance before running migrations.
DATABASE_URL=postgres://admin:local-dev-postgres-password@localhost:5432/event_service_database

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=event-service

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_TIMEOUT_MS=60000
